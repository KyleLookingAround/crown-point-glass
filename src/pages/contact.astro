---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { getSettings, mapEmbedUrl, directionsUrl, hoursRows, hasAddress, telHref } from '../lib/site';

const s = await getSettings();
const entry = await getEntry('contact', 'main');
if (!entry) throw new Error('content/contact.yml is missing');
const c = entry.data;
---

<Base
  title={`Contact — ${s.name}`}
  description={`Get in touch with ${s.name} — glaziers and locksmiths covering ${s.region} and Cheshire. Call ${s.phone}, or ${s.emergencyPhone} for 24hr emergencies.`}
  nav="contact"
  page="contact.html">

<!-- PAGE HEADER -->
<section class="page-head">
  <div class="page-head-grid">
    <div>
      <div class="eyebrow">Get in touch</div>
      <h1 class="page-title">Talk to <em>us.</em></h1>
      <p class="page-lede">{c.intro}</p>
    </div>
    <div>
      <div class="call-stack">
        <a class="bigcall" href={telHref(s.emergencyPhone)}>
          <span class="bc-lbl">24hr emergency</span>
          <span class="bc-num">{s.emergencyPhone}</span>
          <span class="bc-sub">Answered day and night</span>
        </a>
        <a class="bigcall bigcall--office" href={telHref(s.phone)}>
          <span class="bc-lbl">Office</span>
          <span class="bc-num">{s.phone}</span>
          <span class="bc-sub">During working hours</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- FORM + DETAILS -->
<section class="visit">
  <div class="visit-inner">
    <div>
      <div class="visit-label">{c.formTitle}</div>
      <h2>Send the <em>details.</em></h2>

      {s.formEndpoint ? (
        <form class="enquiry" action={s.formEndpoint} method="post">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-phone">Phone number</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
            </div>
            <div class="field">
              <label for="f-postcode">Post code</label>
              <input id="f-postcode" name="postcode" type="text" autocomplete="postal-code" required>
            </div>
          </div>
          <div class="field">
            <label for="f-message">Message</label>
            <textarea id="f-message" name="message" rows="6" required></textarea>
          </div>
          <button class="btn" type="submit">{c.submitLabel}</button>
          <p class="form-note">{c.formNote}</p>
        </form>
      ) : (
        <div class="form-fallback">
          <p>{c.noFormNote}</p>
          <div class="hero-cta">
            <a class="btn" href={telHref(s.emergencyPhone)}>Call {s.emergencyPhone}</a>
            <a class="btn btn-ghost" href={telHref(s.phone)}>Call {s.phone}</a>
          </div>
        </div>
      )}
    </div>

    <div class="map-col">
      <div class="contact-aside">
        <h3>{c.asideTitle}</h3>
        <p>{c.asideBody}</p>
        <ul class="contact-list">
          <li><span class="lbl">Emergency</span><a href={telHref(s.emergencyPhone)}>{s.emergencyPhone}</a></li>
          <li><span class="lbl">Office</span><a href={telHref(s.phone)}>{s.phone}</a></li>
          {s.email && <li><span class="lbl">Email</span><a href={`mailto:${s.email}`}>{s.email}</a></li>}
          {s.facebook && <li><span class="lbl">Facebook</span><a href={s.facebook} target="_blank" rel="noopener">Message us</a></li>}
          {s.instagram && <li><span class="lbl">Instagram</span><a href={s.instagram} target="_blank" rel="noopener">{s.instagramHandle ?? 'See our work'}</a></li>}
        </ul>
        <ul class="hours-list">
          {hoursRows(s).map((hr) => <li><span class="hl-day">{hr.day}</span><span class="hl-time">{hr.time}</span></li>)}
        </ul>
        <p class="hours-note">{s.emergencyNote}</p>
      </div>

      <div class="map-card map-card--wide">
        <iframe
          src={mapEmbedUrl(s)}
          width="100%" height="100%"
          style="border:0; display:block;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={hasAddress(s) ? `${s.name}, ${s.street}, ${s.locality}` : `The area ${s.name} covers`}
          allowfullscreen></iframe>
      </div>
      <a class="map-link" href={directionsUrl(s)} target="_blank" rel="noopener">Open in Google Maps →</a>
    </div>
  </div>
</section>

</Base>
