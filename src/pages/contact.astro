---
import Base from '../layouts/Base.astro';
import Map from '../components/Map.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { getEntry } from 'astro:content';
import { getSettings, hoursRows, telHref } from '../lib/site';

const s = await getSettings();
const entry = await getEntry('contact', 'main');
if (!entry) throw new Error('content/contact.yml is missing');
const c = entry.data;
---

<Base
  title={`Contact — ${s.name}`}
  description={`Get in touch with ${s.name} — glaziers and locksmiths covering ${s.region} and Cheshire. Call ${s.phone}, or ${s.emergencyPhone} for 24hr emergencies.`}
  nav="contact"
  page="contact.html">

<!-- PAGE HEADER -->
<section class="page-head">
  <div class="page-head-grid">
    <div>
      <div class="eyebrow">Get in touch</div>
      <h1 class="page-title">Talk to <em>us.</em></h1>
      <p class="page-lede">{c.intro}</p>
    </div>
    <div>
      <div class="call-stack">
        <a class="bigcall" href={telHref(s.emergencyPhone)}>
          <span class="bc-lbl">24hr emergency</span>
          <span class="bc-num">{s.emergencyPhone}</span>
          <span class="bc-sub">Answered day and night</span>
        </a>
        <a class="bigcall bigcall--office" href={telHref(s.phone)}>
          <span class="bc-lbl">Office</span>
          <span class="bc-num">{s.phone}</span>
          <span class="bc-sub">During working hours</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- FORM + DETAILS -->
<section class="visit">
  <div class="visit-inner">
    <div>
      <div class="visit-label">{c.formTitle}</div>
      <h2>Send the <em>details.</em></h2>

      <EnquiryForm
        variant="contact"
        submitLabel={c.submitLabel}
        note={c.formNote}
        fallbackNote={c.noFormNote} />
    </div>

    <div class="map-col">
      <div class="contact-aside">
        <h3>{c.asideTitle}</h3>
        <p>{c.asideBody}</p>
        <ul class="contact-list">
          <li><span class="lbl">Emergency</span><a href={telHref(s.emergencyPhone)}>{s.emergencyPhone}</a></li>
          <li><span class="lbl">Office</span><a href={telHref(s.phone)}>{s.phone}</a></li>
          {s.email && <li><span class="lbl">Email</span><a href={`mailto:${s.email}`}>{s.email}</a></li>}
          {s.facebook && <li><span class="lbl">Facebook</span><a href={s.facebook} target="_blank" rel="noopener">Message us</a></li>}
          {s.instagram && <li><span class="lbl">Instagram</span><a href={s.instagram} target="_blank" rel="noopener">{s.instagramHandle ?? 'See our work'}</a></li>}
        </ul>
        <ul class="hours-list">
          {hoursRows(s).map((hr) => <li><span class="hl-day">{hr.day}</span><span class="hl-time">{hr.time}</span></li>)}
        </ul>
        <p class="hours-note">{s.emergencyNote}</p>
      </div>

      <Map variant="wide" linkLabel="Open in Google Maps →" />
    </div>
  </div>
</section>

</Base>
