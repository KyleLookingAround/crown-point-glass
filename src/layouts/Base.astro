---
/**
 * The shared shell: head (meta/OG/JSON-LD), top bar with the emergency
 * number, credentials strip and footer. Every page renders inside this.
 */
import { getSettings, ogImage, hoursData, jsonLd, breadcrumbLd, canonicalUrl, statusShort, telHref } from '../lib/site';
import { imageSize } from '../lib/imageSize';

type Nav = 'home' | 'services' | 'emergency' | 'work' | 'faq' | 'quote' | 'contact';

interface Props {
  title: string;
  description: string;
  /** which top-nav item is highlighted */
  nav?: Nav;
  /** the page's file name, e.g. "services.html" — "index.html" for home */
  page?: string;
  /** keep this page out of search results (the thank-you page) */
  noindex?: boolean;
}

// The nav, defined once and rendered in both the header and the footer, so
// adding a page can't leave the two lists disagreeing.
const LINKS: { nav: Nav; href: string; label: string }[] = [
  { nav: 'home', href: './', label: 'Home' },
  { nav: 'services', href: './services.html', label: 'Services' },
  { nav: 'emergency', href: './emergency.html', label: 'Emergency' },
  { nav: 'work', href: './work.html', label: 'Our work' },
  { nav: 'faq', href: './faq.html', label: 'FAQs' },
  { nav: 'quote', href: './quote.html', label: 'Get a quote' },
  { nav: 'contact', href: './contact.html', label: 'Contact' },
];

const { title, description, nav, page = '', noindex = false } = Astro.props;
const s = await getSettings();
const pageUrl = canonicalUrl(s, page);
const year = new Date().getFullYear();
const active = (n: string) => (nav === n ? 'active' : undefined);
// The home page gets no breadcrumb — a one-item trail tells nobody anything.
const crumbLabel = LINKS.find((l) => l.nav === nav && l.nav !== 'home')?.label;
---

<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={pageUrl} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content="#0b1926" />

<!-- Favicon — the crown mark, carried over from the previous site -->
<link rel="icon" type="image/png" sizes="32x32" href="./assets/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="196x196" href="./assets/favicon-196x196.png">

<!-- Open Graph / Social sharing -->
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={pageUrl}>
<meta property="og:locale" content="en_GB">
<meta property="og:site_name" content={s.name}>
<meta property="og:image" content={ogImage(s)}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${s.name} — ${s.strapline} ${s.region}.`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage(s)}>

<link rel="apple-touch-icon" href="./assets/apple-touch-icon-152x152.png">
<link rel="manifest" href="./site.webmanifest">
<link rel="sitemap" href="./sitemap-index.xml">

<link rel="preload" href="./assets/fonts/dmsans.woff2" as="font" type="font/woff2" crossorigin>

<link rel="stylesheet" href="./styles.css">

<!-- LocalBusiness structured data (helps Google Search & Maps). -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd(s)).replace(/</g, '\\u003c')} />

<!-- Breadcrumb trail under the Google result, on interior pages. -->
{crumbLabel && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd(s, crumbLabel, page)).replace(/</g, '\\u003c')} />
)}

<!-- per-page additions (e.g. the FAQ page's FAQPage structured data) -->
<slot name="head" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<!-- EMERGENCY BAR — always the first thing on the page -->
<div class="alertbar">
  <span class="alertbar-dot" aria-hidden="true"></span>
  <span class="alertbar-text">Broken glass? 24hr emergency boarding &amp; repairs</span>
  <a class="alertbar-call" href={telHref(s.emergencyPhone)}>{s.emergencyPhone}</a>
</div>

<!-- TOP BAR -->
<header class="topbar">
  <a class="logo" href="./">
    <img src="./assets/logo.png" alt={s.name} width="551" height="248" />
  </a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
  {/* aria-controls names the menu the button opens, not the checkbox that
      drives it — a screen reader user following it should land on the nav. */}
  <label for="nav-toggle" class="burger" aria-label="Open menu" title="Menu" tabindex="0" role="button" aria-expanded="false" aria-controls="main-nav">
    <span></span><span></span><span></span>
  </label>
  <nav id="main-nav" aria-label="Main">
    {LINKS.map((l) => (
      <a href={l.href} class={active(l.nav)} aria-current={nav === l.nav ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="topbar-right">
    <div class="status" data-open-status title="Opening hours">
      <span class="pulse"></span><span class="status-text">{statusShort(s)}</span>
    </div>
    <a class="topbar-call" href={telHref(s.phone)}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3.5 5.2 2 2 0 0 1 5.5 3z"/>
      </svg>
      <span>{s.phone}</span>
    </a>
  </div>
</header>

<main id="main">
<slot />
</main>

{s.credentials.length > 0 && (
  <aside class="press" aria-label="Company details">
    <span class="press-label">Registered &amp; findable</span>
    <ul class="press-list">
      {s.credentials.map((c) => {
        // Badges are uploaded through /admin, so their size is read from the
        // file rather than assumed — see src/lib/imageSize.ts.
        const size = c.image ? imageSize(c.image) : null;
        return (
          <li>
            <a href={c.url} target="_blank" rel="noopener" title={c.name}>
              {c.image
                ? <img src={c.image} alt={c.name} width={size?.width ?? 200} height={size?.height ?? 80} loading="lazy" />
                : <>{c.name} ↗</>}
            </a>
          </li>
        );
      })}
    </ul>
  </aside>
)}

<!-- FOOTER -->
<footer>
  <p class="foot-addr">{s.region} &amp; Cheshire</p>
  <img class="foot-logo" src="./assets/logo.png" alt={s.name} width="551" height="248" loading="lazy" />
  <p class="foot-strap">{s.strapline}</p>

  <div class="foot-calls">
    <a class="foot-call" href={telHref(s.phone)}>
      <span class="fc-lbl">Office</span><span class="fc-num">{s.phone}</span>
    </a>
    <a class="foot-call foot-call--urgent" href={telHref(s.emergencyPhone)}>
      <span class="fc-lbl">24hr emergency</span><span class="fc-num">{s.emergencyPhone}</span>
    </a>
  </div>

  <nav class="foot-nav" aria-label="Footer">
    {LINKS.map((l) => <a href={l.href} aria-current={nav === l.nav ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <div class="socials">
    {s.email
      ? <a href={`mailto:${s.email}`}>Email</a>
      : <a href="./contact.html">Enquiry form</a>}
    {s.facebook && <a href={s.facebook} target="_blank" rel="noopener">Facebook</a>}
    {s.instagram && <a href={s.instagram} target="_blank" rel="noopener">Instagram</a>}
  </div>
  <div class="small">
    © {year} {s.legalName}
    {s.street && s.postcode
      ? ` · ${s.street}, ${s.locality} ${s.postcode}`
      : ` · Covering ${s.region} & Cheshire`}
    {s.companyNumber && ` · Registered in England & Wales no. ${s.companyNumber}`}
  </div>
</footer>

<!-- Opening-hours data (read by the app script for the live open/closed status) -->
<script is:inline set:html={`window.__CPG__=${JSON.stringify(hoursData(s))};`} />
<script src="../scripts/app.ts"></script>

</body>
</html>
