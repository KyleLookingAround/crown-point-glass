{
  "name": "crown-point-glass",
  "version": "1.0.0",
  "description": "Crown Point Glass — glazing, glass supply and 24hr emergency board-up. Astro static site built from YAML content.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run build && npm run test:only",
    "test:only": "node --experimental-strip-types --test test/*.test.ts",
    "verify": "npm run check && npm test",
    "astro": "astro"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.0",
    "astro": "^5.12.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.9.2"
  }
}
